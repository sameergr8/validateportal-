# Copy this file to .env.local and fill in real values for local dev.
# Anything prefixed with NEXT_PUBLIC_ is exposed to the browser — do not put secrets there.

# Base URL of the Laravel REST API. While the backend is being built, this is unused
# (the frontend reads from lib/mocks.ts when NEXT_PUBLIC_USE_MOCKS=true).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# When "true", lib/api.ts returns mock data from lib/mocks.ts.
# Flip to "false" once the Laravel backend is reachable at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_MOCKS=true

# UAE Pass OAuth (sandbox) — leave blank until client provides credentials.
NEXT_PUBLIC_UAEPASS_CLIENT_ID=
UAEPASS_CLIENT_SECRET=
NEXT_PUBLIC_UAEPASS_REDIRECT_URI=http://localhost:3000/auth/uaepass/callback
